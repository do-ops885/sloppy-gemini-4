{
  "$schema": "https://design-tokens.org/schema/2024-10/draft",
  "name": "vaporware-pool",
  "description": "Design tokens for the GEMINI 4 PRO Vaporware Pool parody terminal. Consumed as tokens.css (CSS custom properties) and mirrored into the Tailwind CDN config. Springs are JS-side (app.js).",
  "color": {
    "primitive": {
      "void-950": { "$type": "color", "$value": "#07080d" },
      "void-900": { "$type": "color", "$value": "#0d1017" },
      "void-800": { "$type": "color", "$value": "#141826" },
      "void-700": { "$type": "color", "$value": "#1c2133" },
      "ink-100": { "$type": "color", "$value": "#f8fafc" },
      "ink-200": { "$type": "color", "$value": "#e2e8f0" },
      "ink-300": { "$type": "color", "$value": "#cbd5e1" },
      "ink-400": { "$type": "color", "$value": "#94a3b8" },
      "ink-500": { "$type": "color", "$value": "#64748b" },
      "ink-600": { "$type": "color", "$value": "#475569" },
      "cyan-400": { "$type": "color", "$value": "#00f0ff", "$description": "Hyper-Cyan" },
      "green-500": { "$type": "color", "$value": "#10b981", "$description": "Toxic Synth-Green" },
      "magenta-500": { "$type": "color", "$value": "#ff007f", "$description": "Hallucination Magenta" },
      "gold-400": { "$type": "color", "$value": "#facc15", "$description": "Panic Gold" }
    },
    "semantic": {
      "surface-base": { "$type": "color", "$value": "{color.primitive.void-950}" },
      "surface-raised": { "$type": "color", "$value": "{color.primitive.void-900}" },
      "surface-card": { "$type": "color", "$value": "{color.primitive.void-800}" },
      "text-primary": { "$type": "color", "$value": "{color.primitive.ink-200}" },
      "text-heading": { "$type": "color", "$value": "{color.primitive.ink-100}" },
      "text-secondary": { "$type": "color", "$value": "{color.primitive.ink-400}" },
      "text-muted": { "$type": "color", "$value": "{color.primitive.ink-500}" },
      "accent-hyper": { "$type": "color", "$value": "{color.primitive.cyan-400}" },
      "accent-toxic": { "$type": "color", "$value": "{color.primitive.green-500}" },
      "accent-halluc": { "$type": "color", "$value": "{color.primitive.magenta-500}" },
      "accent-panic": { "$type": "color", "$value": "{color.primitive.gold-400}" }
    }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": ["Syne", "ui-sans-serif", "system-ui", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["Space Mono", "ui-monospace", "SFMono-Regular", "monospace"] },
    "poster": { "$type": "fontFamily", "$value": ["Archivo Black", "Syne", "ui-sans-serif", "sans-serif"] }
  },
  "motion": {
    "duration": {
      "enter": { "$type": "duration", "$value": "240ms" },
      "exit": { "$type": "duration", "$value": "110ms" },
      "fade": { "$type": "duration", "$value": "150ms", "$description": "Reduced-motion flat fade" }
    },
    "easing": {
      "out": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] },
      "in": { "$type": "cubicBezier", "$value": [0.7, 0, 0.84, 0] }
    },
    "spring": {
      "modal": { "$type": "spring", "$value": { "stiffness": 380, "damping": 28, "mass": 1 }, "$description": "Cards, drawer, tilt (JS: SPRING_MODAL)" },
      "counter": { "$type": "spring", "$value": { "stiffness": 240, "damping": 24, "mass": 1 }, "$description": "Odds & payout tickers (JS: SPRING_COUNTER)" }
    }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "10px" },
    "lg": { "$type": "dimension", "$value": "14px" },
    "xl": { "$type": "dimension", "$value": "16px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "elevation": {
    "z": {
      "marquee": { "$value": 20 }, "header": { "$value": 40 }, "overlay": { "$value": 55 },
      "drawer": { "$value": 60 }, "toast": { "$value": 80 }, "confetti": { "$value": 90 }
    },
    "shadow": {
      "card": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "18px", "blur": "50px", "color": "rgba(0,0,0,0.55)" } },
      "panel": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "20px", "blur": "60px", "color": "rgba(0,0,0,0.5)" } }
    }
  }
}
